# Woolworths Supplier Portal
PORTAL_URL=http://caissanet.woolworths.co.za
PORTAL_USERNAME=your_username
PORTAL_PASSWORD=your_password

# Supplier code shown in the supplier dropdown (e.g. 71000)
SUPPLIER_CODE=71000

# How many days back from today to download
DAYS_BACK=30

# Folder to save downloaded files (relative to project root)
DOWNLOADS_DIR=downloads
